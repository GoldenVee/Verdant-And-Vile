# Copy this file to .env for local development, then fill in DATABASE_URL.
#
# Environments are selected by the DATABASE_URL value the environment provides, not by
# a code branch:
#
#   Local dev  -> this .env file (gitignored), pointing at the Neon `dev` branch.
#   Tests      -> same .env (tests currently reuse the dev branch).
#   Production -> DATABASE_URL set as a host environment variable (managed platform
#                 dashboard, or a gitignored .env on a self-hosted server), pointing at
#                 the Neon `main` branch. Never commit production credentials.
#
# .gitignore blocks .env and every .env.* except this example, so any .env.production
# you create locally or on a server stays out of git.

# Neon Postgres connection string. Use the pooled connection string (host contains
# "-pooler") for app runtime.
DATABASE_URL=

# development | test | production. Drives behavior (logging, error detail), not database
# selection. Defaults to development if unset.
NODE_ENV=development

# HTTP server
PORT=3000

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
