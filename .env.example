# Neon Postgres connection string (use the pooled connection string from the Neon console).
# Example shape: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# HTTP server
PORT=3000

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
